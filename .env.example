# ===== AI provider mode =====
# The ensemble is two models: Codex GPT-5.6 (sol) — the lead — and Gemini 3.5
# Flash (the reviewer). Choose how each is invoked:
#   "cli"  → spawn the local `codex` + `agy` (Gemini) binaries (best for local dev)
#   "api"  → call hosted APIs over HTTPS (required for cloud deployments)
#
# Global default for both providers. Override per-provider below.
AI_MODE=cli

# Per-provider overrides (optional). Leave unset to inherit AI_MODE.
# OPENAI_MODE=api
# GEMINI_MODE=api

# ===== OpenAI (Codex / GPT-5.6 sol) — LEAD reasoner (xhigh) =====
# Required when OPENAI_MODE=api (or AI_MODE=api).
# OPENAI_API_KEY=sk-...
# OPENAI_MODEL=gpt-5.6-sol                      # optional override
# OPENAI_BASE_URL=https://api.openai.com        # optional, for proxies

# ===== Google (Gemini 3.5 Flash) — REVIEWER (high) =====
# API mode: required when GEMINI_MODE=api (or AI_MODE=api).
# GEMINI_API_KEY=...
# GEMINI_MODEL=gemini-3.5-flash                 # optional override (API mode)
# GEMINI_BASE_URL=https://generativelanguage.googleapis.com  # optional, for proxies
# CLI mode uses the `agy` binary + a human-readable model name:
# GEMINI_CLI_BIN=agy                            # optional override
# GEMINI_CLI_MODEL=Gemini 3.5 Flash (High)      # optional override

# ===== Auth / sessions =====
# Required. HMAC key used to sign the `sov_session` cookie issued by SIWE login.
# Must be >= 32 chars. Routes under /api/strategies* refuse to serve without it.
# Generate with: openssl rand -hex 32
SESSION_SECRET=

# ===== Wallet / web3 =====
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=demo

# ===== RPC providers =====
# wagmi/viem default to public RPCs which rate-limit aggressively. Set ONE of:
#   1) Per-chain explicit URL (highest priority)
#   2) ALCHEMY_API_KEY (auto-builds URLs for ethereum/base/arbitrum/optimism/polygon)
#   3) INFURA_API_KEY (auto-builds URLs for ethereum/arbitrum/optimism/polygon)
# ALCHEMY_API_KEY=
# INFURA_API_KEY=
# RPC_URL_ETHEREUM=
# RPC_URL_BASE=
# RPC_URL_ARBITRUM=
# RPC_URL_OPTIMISM=
# RPC_URL_POLYGON=
# RPC_URL_BSC=

# ===== On-chain forensics =====
# Etherscan V2 covers Ethereum, Base, Arbitrum, Optimism, Polygon, BSC with one key.
ETHERSCAN_API_KEY=

# ===== Alerts (per-user delivery) =====
# Each user configures their own channels at /account/alerts. The server-side
# providers below need to be configured for those channels to be available.

# Email via Resend. Free tier: 3,000 emails/month.
# 1. Sign up at https://resend.com  (free, no card)
# 2. Generate an API key in the dashboard
# 3. (Optional) verify a domain and set RESEND_FROM=alerts@your-domain.com
#    — without a verified domain, Resend will only deliver to the account owner.
# RESEND_API_KEY=re_...
# RESEND_FROM=Sovereign <alerts@your-domain.com>

# Telegram bot. Free, unlimited messages.
# 1. Open Telegram, message @BotFather, run /newbot, follow prompts
# 2. Save the token BotFather gives you below
# 3. Save the bot's username (without @) so the deeplink can build correctly
# TELEGRAM_BOT_TOKEN=123456:ABC-DEF...
# TELEGRAM_BOT_USERNAME=YourSovereignBot

# ===== Alerts (server-wide ops channel, optional) =====
# Legacy: every alert from every user ALSO fans out to this single Discord
# webhook for staff visibility. Independent of per-user channels.
DISCORD_WEBHOOK_URL=

# ===== Cron (optional on a single-server deploy) =====
# The in-process scheduler runs the 15-min monitor/reconciler/reminder sweep
# automatically once any strategy route is hit. An EXTERNAL cron (systemd
# timer, crontab, uptime service) can additionally GET /api/cron/monitor with
# `Authorization: Bearer <CRON_SECRET>` as a belt-and-braces trigger.
# Required only if you use that external route in production.
# Generate with: openssl rand -hex 32
CRON_SECRET=

# ===== Plans / paywall =====
# Comma-separated lowercase 0x addresses that always resolve to the Ultra tier.
# Useful for the project owner's wallet so testing/demo bypasses the paywall.
# OWNER_WALLETS=0xabc...,0xdef...

# ===== Crypto payments =====
# Defaults are baked into src/lib/payments/config.ts; override here per-deployment.
# All EVM chains (ETH, USDC/USDT on ETH+BSC) settle to the EVM address.
# PAYMENT_ADDRESS_EVM=0x35DE0b4157Ecb2037AB1041d2333981E81BAEF24
# PAYMENT_ADDRESS_BTC=bc1qjuekjcmlxs90cepkp8qtvanj20hamu74f6t8a3
# PAYMENT_ADDRESS_SOL=72FEbjJmA4Ac37gSpceF9KLmamvCY3tBgYRCoarDDFfM
# PAYMENT_ADDRESS_TRON=  # leave unset to disable Tron

# Optional: TronGrid + Solana RPC + mempool.space overrides.
# TRONGRID_API_KEY=
# TRONGRID_API_URL=https://api.trongrid.io
# SOLANA_RPC_URL=https://api.mainnet-beta.solana.com
# MEMPOOL_API_URL=https://mempool.space/api
