# Copy to .env.local. Never commit real values.

# ===== Canonical origin, sessions, and encrypted local data =====
# Generate independent values with: openssl rand -hex 32
SESSION_SECRET=
# Recommended in production so rotating SESSION_SECRET does not invalidate
# stored notification endpoints or public audit-share capabilities.
# CHANNEL_ENCRYPTION_KEY=
# AUDIT_SHARE_SECRET=

# Canonical public origin used for SIWE and Origin validation.
# Production example: https://app.example.com (no path/query)
NEXT_PUBLIC_APP_HOST=http://localhost:3000

# Only enable behind a trusted reverse proxy that overwrites Forwarded and
# X-Forwarded-* headers. The canonical origin above remains authoritative.
# When false, anonymous requests share one conservative direct-connection
# rate-limit bucket; this is spoof-resistant but can reduce public availability.
TRUST_PROXY_HEADERS=false

# Absolute path on a persistent, backed-up disk in production.
# DATABASE_PATH=/var/lib/sovereign/sovereign.db

# ===== Wallet connection =====
# A real project ID is required by production builds. Injected wallets still
# work in local development when this is left as demo.
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=demo

# ===== AI providers =====
# cli: local codex + agy binaries. api: hosted HTTPS APIs.
AI_MODE=cli
# OPENAI_MODE=api
# GEMINI_MODE=api

# OPENAI_API_KEY=sk-...
# OPENAI_MODEL=gpt-5.6-sol
# OPENAI_BASE_URL=https://api.openai.com

# GEMINI_API_KEY=...
# GEMINI_MODEL=gemini-3.5-flash
# GEMINI_BASE_URL=https://generativelanguage.googleapis.com
# GEMINI_CLI_MODEL=gemini-3.6-flash-high

# Optional telemetry pricing. If omitted, token estimates are recorded with a
# null cost. Prompts and model output are never stored in ai_usage_events.
# OPENAI_INPUT_USD_PER_MILLION=
# OPENAI_OUTPUT_USD_PER_MILLION=
# GEMINI_INPUT_USD_PER_MILLION=
# GEMINI_OUTPUT_USD_PER_MILLION=

# ===== RPC providers =====
# Priority: explicit URL, then Alchemy/Infura where supported, then public RPC.
# ALCHEMY_API_KEY=
# INFURA_API_KEY=
# RPC_URL_ETHEREUM=
# RPC_URL_ARBITRUM=
# RPC_URL_OPTIMISM=
# RPC_URL_POLYGON=
# RPC_URL_BASE=
# RPC_URL_BSC=
# RPC_URL_AVALANCHE=

# ===== Contract source and on-chain review =====
ETHERSCAN_API_KEY=

# ===== EVM subscription payments =====
# Required to enable checkout. No recipient address is baked into the app.
# This one merchant address receives ETH/USDC/USDT on Ethereum and USDC/USDT
# on BSC. It must be a 20-byte EVM address.
# PAYMENT_ADDRESS_EVM=0x0000000000000000000000000000000000000000

# ===== Per-user notifications =====
# Email via Resend.
# RESEND_API_KEY=re_...
# RESEND_FROM=Sovereign <alerts@example.com>

# Telegram bot polling for the single-process deployment.
# TELEGRAM_BOT_TOKEN=123456:ABC-DEF...
# TELEGRAM_BOT_USERNAME=YourSovereignBot

# Optional staff/ops Discord webhook. Every newly opened incident is copied
# here in addition to the wallet owner's configured channels.
# DISCORD_WEBHOOK_URL=

# ===== External monitor trigger =====
# Required when an external scheduler calls GET /api/cron/monitor in production.
# CRON_SECRET=

# ===== Owner/development controls =====
# Comma-separated EVM wallets that resolve to Ultra for staff testing.
# OWNER_WALLETS=0xabc...,0xdef...

# Localhost-only SIWE bypass. Never enable in production.
# ENABLE_DEV_LOGIN=false
# DEV_LOGIN_SECRET=generate-a-separate-random-value-of-at-least-32-characters
